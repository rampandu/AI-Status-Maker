<?xml version="1.0" encoding="utf-8"?>
<!-- Structure: toolbar / scrollable preview content / PINNED bottom action
     bar. Export + progress + share live in the pinned bar so they are always
     visible — previously they sat below the (very tall) 9:16 preview inside
     the scroll view and were off-screen on every phone. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Preview &amp; Export"
            app:titleTextColor="@color/text_primary" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Preview Card: animated frame preview BEFORE export, ExoPlayer AFTER export.
                 Height is capped so the action bar below always has room. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/hairline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_dark">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Animated bitmap preview (shown before export) -->
                    <ImageView
                        android:id="@+id/ivPreviewFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="420dp"
                        android:scaleType="fitCenter"
                        android:minHeight="240dp"
                        android:background="@color/bg_dark" />

                    <!-- ExoPlayer video view (shown after export) -->
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/playerView"
                        android:layout_width="match_parent"
                        android:layout_height="420dp"
                        android:visibility="gone"
                        app:resize_mode="fit"
                        app:show_buffering="when_playing"
                        app:use_controller="true"
                        app:hide_on_touch="false"
                        app:repeat_toggle_modes="one" />

                    <!-- "LIVE PREVIEW" badge -->
                    <TextView
                        android:id="@+id/tvLivePreviewBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_duration_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="⏯ PREVIEW"
                        android:textColor="@color/accent_gold"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Template Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPreviewCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvPreviewTemplateName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Ad Notice (free users) — glass card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_overlay"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_gold"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/tvAdNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="13dp"
                    android:text="📺 Watch a short ad to export without watermark. Upgrade to Premium to skip ads!"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Pinned bottom action bar — always visible ─────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_dark">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp">

            <!-- Export Progress -->
            <LinearLayout
                android:id="@+id/exportProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvExportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Preparing..."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/exportProgressBar"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progressTint="@color/accent_gold" />
            </LinearLayout>

            <!-- Export Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎬 Export Video"
                android:textSize="16sp" />

            <!-- Share Buttons (shown after export) -->
            <LinearLayout
                android:id="@+id/exportSuccessGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="✅ Video exported — tap Play above to watch!"
                    android:textColor="@color/success"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWhatsApp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#25D366"
                        android:text="WhatsApp"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/radius_sm"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/accent_blue"
                        android:text="Share"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/radius_sm"
                        app:icon="@drawable/ic_share"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditAgain"
                    style="@style/Widget.App.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Edit Again" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
