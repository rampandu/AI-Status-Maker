<resources>

    <!-- ── Typography scale ───────────────────────────────────────────────
         Display/headline use sans-serif-black for real weight contrast;
         body copy stays on plain sans-serif for legibility. No custom font
         assets needed — these are all system font families. -->

    <style name="TextAppearance.App.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">sans-serif-black</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ── Buttons ────────────────────────────────────────────────────────── -->

    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button_primary_ripple</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button_outline_ripple</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
